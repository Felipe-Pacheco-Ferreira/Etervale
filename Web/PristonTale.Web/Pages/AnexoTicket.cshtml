@page "/suporte/anexo/{ticketId:guid}"
@model AnexoTicketModel
@{ ViewData["Title"] = "Anexar imagem ou vídeo"; }
<div class="page page-narrow">
    <form class="plate form" method="post" enctype="multipart/form-data">
        <h1>Anexar imagem ou vídeo</h1>
        <div asp-validation-summary="All" role="alert"></div>
        <label asp-for="Arquivo">PNG, JPEG, WebP, MP4 ou WebM, até 20 MB</label>
        <input asp-for="Arquivo" type="file" accept=".png,.jpg,.jpeg,.webp,.mp4,.webm" required />
        <button type="submit">Enviar anexo</button>
    </form>
</div>
