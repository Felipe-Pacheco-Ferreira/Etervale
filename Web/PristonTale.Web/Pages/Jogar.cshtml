@page "/"
@inject BrowserClient Client
@inject WebSettings Settings
@inject TermsOfUse Terms
@inject Turnstile Turnstile
@using PristonTale.Contracts.Sessions
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>@Settings.Site.Name</title>
    <meta name="description" content="Noxius, MMORPG de fantasia. Jogue direto no navegador, sem instalar nada.">
    <meta name="theme-color" content="#0a0c11">
    <meta name="color-scheme" content="dark">
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/favicon-32.png" asp-append-version="true">
    <link rel="apple-touch-icon" href="~/img/icon-192.png" asp-append-version="true">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="stylesheet" href="~/css/play.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true">
</head>
<body class="stage">
    @* The game draws into #canvas (the MonoGame runtime's window), which fills the window; the page's panels sit over it.
       The keyboard reaches the game only while the canvas has the focus, so the form's fields keep their keys. *@
    <div class="game" id="jogo" data-endpoint="@Client.Endpoint" data-state="loading">
        <canvas id="canvas" class="game-canvas" tabindex="0" aria-label="@Settings.Site.Name"></canvas>
        <div class="turn-hint" data-role="turn-hint" role="alert">
            <span class="turn-hint-icon" aria-hidden="true">📱</span>
            <strong>Gire o celular</strong>
            <span>O Noxius é jogado com o aparelho deitado.</span>
            <button type="button" class="turn-hint-dismiss" data-turn-hint-dismiss>Continuar em pé</button>
        </div>

        <div class="game-bar" data-role="game-tools">
            <label class="game-language">
                <span class="dot" aria-hidden="true"></span>
                <span class="game-language-label" data-text="language">Idioma</span>
                <select data-role="language" aria-label="Idioma do jogo">
                    <option value="pt-BR">Português</option>
                    <option value="en">English</option>
                    <option value="es">Español</option>
                    <option value="fil">Filipino</option>
                    <option value="vi">Tiếng Việt</option>
                    <option value="zh-CN">简体中文</option>
                    <option value="ja">日本語</option>
                </select>
            </label>
            @if (Client.IsAvailable)
            {
                <button type="button" class="icon-button" data-role="settings-open" aria-label="Configurações" title="Configurações">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.4 13a7.6 7.6 0 0 0 0-2l2-1.6-2-3.4-2.4 1a7.4 7.4 0 0 0-1.7-1L15 3.5h-4l-.4 2.5a7.4 7.4 0 0 0-1.7 1l-2.4-1-2 3.4 2 1.6a7.6 7.6 0 0 0 0 2l-2 1.6 2 3.4 2.4-1a7.4 7.4 0 0 0 1.7 1l.4 2.5h4l.4-2.5a7.4 7.4 0 0 0 1.7-1l2.4 1 2-3.4zM13 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z" transform="translate(-1 0)"/></svg>
                </button>
            }
            else
            {
                <details class="game-menu">
                    <summary class="icon-button" aria-label="Menu do site" title="Menu do site">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.4 13a7.6 7.6 0 0 0 0-2l2-1.6-2-3.4-2.4 1a7.4 7.4 0 0 0-1.7-1L15 3.5h-4l-.4 2.5a7.4 7.4 0 0 0-1.7 1l-2.4-1-2 3.4 2 1.6a7.6 7.6 0 0 0 0 2l-2 1.6 2 3.4 2.4-1a7.4 7.4 0 0 0 1.7 1l.4 2.5h4l.4-2.5a7.4 7.4 0 0 0 1.7-1l2.4 1 2-3.4zM13 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z" transform="translate(-1 0)"/></svg>
                    </summary>
                    <nav class="game-menu-list" aria-label="Site">
                        <partial name="_PlaySiteLinks" />
                    </nav>
                </details>
            }
            @if (Client.IsAvailable)
            {
                <button type="button" class="icon-button opening-sound" data-role="opening-sound" aria-pressed="false"
                        aria-label="Música da abertura" title="Música da abertura" hidden>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 9h4l5-4v14l-5-4H4z"/>
                        <path class="sound-waves" d="M16 9a4 4 0 0 1 0 6m2-8a7 7 0 0 1 0 10"/>
                        <path class="sound-muted" d="m16 10 4 4m0-4-4 4"/>
                    </svg>
                </button>
                <audio data-role="opening-music" preload="none" loop hidden></audio>
            }
            <button type="button" class="icon-button" data-role="fullscreen" aria-label="Tela cheia" title="Tela cheia">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"/></svg>
            </button>
        </div>

        @if (!Client.IsAvailable)
        {
            <section class="card card-login">
                <h1 class="card-title">Em breve</h1>
                <div class="card-ornament" aria-hidden="true"><span></span></div>
                <p class="card-text">A versão para navegador está sendo preparada.</p>
                <a class="card-button" href="/download">Baixar o jogo</a>
                <nav class="card-links"><a href="/inicio">Ir para o site</a></nav>
            </section>
        }
        else
        {
            <div class="card card-framed auth-shell">
                <partial name="_LoginCorners" />
                <section class="card-login auth-view" data-role="login" aria-labelledby="login-title" hidden>
                    <h1 class="card-title" id="login-title" data-text="title">Bem-vindo</h1>
                    <div class="card-ornament" aria-hidden="true"><span></span></div>
                    <section class="login-recent" data-role="recent-session" aria-labelledby="recent-session-title" hidden>
                        <h2 id="recent-session-title" data-text="recentAccounts">Contas recentes</h2>
                        <div class="login-recent-row">
                            <button type="button" class="login-recent-account" data-role="resume-session">
                                <span class="login-recent-avatar" data-role="recent-avatar" aria-hidden="true"></span>
                                <span>
                                    <strong data-role="recent-account"></strong>
                                    <small data-text="connected">Conectado</small>
                                </span>
                            </button>
                            <button type="button" class="login-recent-forget" data-role="forget-session" aria-label="Esquecer conta">×</button>
                        </div>
                    </section>
                    <form data-role="login-form" autocomplete="on" novalidate>
                        <label class="field">
                            <span data-text="account">Conta</span>
                            <input name="username" data-role="account" placeholder="Sua ID" autocomplete="username" maxlength="20" spellcheck="false" autocapitalize="off" required>
                        </label>
                        <label class="field">
                            <span data-text="password">Senha</span>
                            <input name="password" type="password" data-role="password" placeholder="••••••••" autocomplete="current-password" maxlength="20" required>
                        </label>
                        <div class="login-checks">
                            <label class="check">
                                <input type="checkbox" data-role="remember">
                                <span data-text="remember">Lembrar conta</span>
                            </label>
                            <label class="check">
                                <input type="checkbox" data-role="stay-connected">
                                <span data-text="stayConnected">Manter conectado</span>
                            </label>
                        </div>
                        <p class="card-message" data-role="message" role="status" aria-live="polite"></p>
                        <button type="submit" class="card-button" data-role="submit" data-text="submit">Entrar</button>
                    </form>
                    <nav class="card-links" aria-label="Conta">
                        <a href="/suporte" data-text="forgotPassword" data-recovery="password">Esqueci a senha</a>
                        <span aria-hidden="true">·</span>
                        <a href="/suporte" data-text="forgotId" data-recovery="id">Esqueci o ID</a>
                    </nav>
                    <nav class="card-links card-links-strong" aria-label="Site">
                        <a href="/cadastro" data-text="register" data-role="open-register">Criar conta</a>
                        <span aria-hidden="true">·</span>
                        <a href="/inicio" data-text="leave">Sair</a>
                    </nav>
                    <a class="card-button card-button-outline" href="/download">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v11H3zM8 20h8M12 16v4"/></svg>
                        <span data-text="install">Instalar no PC</span>
                    </a>
                </section>

                @* After the login form: the worlds of /api/worlds, each with its status, ping and players (its game server's
                   /status). Choosing one logs in on its server. *@
                <section class="card-worlds auth-view" data-role="worlds" aria-labelledby="worlds-title" hidden>
                    <p class="card-kicker" data-text="servers">Servidores</p>
                    <h1 class="card-title" id="worlds-title" data-text="chooseWorld">Escolha o mundo</h1>
                    <div class="card-ornament" aria-hidden="true"><span></span></div>
                    <p class="card-subtitle" data-role="worlds-account"></p>
                    <ul class="world-list" data-role="world-list"></ul>
                    <p class="card-message" data-role="worlds-message" role="status" aria-live="polite"></p>
                    <button type="button" class="card-back" data-role="switch-account">‹ <span data-text="switchAccount">Trocar de conta</span></button>
                </section>
            </div>

            <dialog class="card card-framed card-recovery" data-role="recovery" aria-labelledby="recovery-title"
                    aria-describedby="recovery-info">
                <partial name="_LoginCorners" />
                <div class="recovery-content">
                    <p class="recovery-eyebrow" data-text="recoverAccount">Recuperar conta</p>
                    <h2 class="card-title" id="recovery-title" data-role="recovery-title"></h2>
                    <div class="card-ornament" aria-hidden="true"><span></span></div>
                    <p class="recovery-info" id="recovery-info" data-role="recovery-info"></p>
                    <form data-role="recovery-form" method="dialog">
                        <label class="field">
                            <span data-role="recovery-label"></span>
                            <input data-role="recovery-input" required autofocus>
                        </label>
                        <p class="card-message" data-role="recovery-message" aria-live="polite"></p>
                        <div class="recovery-actions">
                            <button type="submit" class="card-button" data-role="recovery-submit"></button>
                            <button type="button" class="card-button card-button-outline" data-role="recovery-cancel"
                                    data-text="cancel">Cancelar</button>
                        </div>
                    </form>
                </div>
            </dialog>

            @* "Criar conta" over the scene: posts to RegistrationApi (/api/conta). The terms must be scrolled to their end
               before they can be accepted; the Cloudflare check shows only when Security:Turnstile* is configured. *@
            <section class="card card-framed card-register" data-role="register" aria-labelledby="register-title" hidden>
                <partial name="_LoginCorners" />
                <div class="register-content">
                    <h1 class="card-title" id="register-title">Criar conta</h1>
                    <div class="card-ornament" aria-hidden="true"><span></span></div>
                    <form data-role="register-form" autocomplete="on" novalidate>
                        <label class="field">
                            <span>Conta</span>
                            <input name="account" data-field="account" autocomplete="username" maxlength="@AccountRules.MaxNameLength" spellcheck="false"
                                   autocapitalize="off" placeholder="@AccountRules.MinNameLength a @AccountRules.MaxNameLength letras ou números">
                        </label>
                        <label class="field">
                            <span>E-mail</span>
                            <input name="email" type="email" data-field="email" autocomplete="email" maxlength="@AccountRules.MaxEmailLength"
                                   placeholder="voce@exemplo.com">
                        </label>
                        <label class="field">
                            <span>Senha</span>
                            <input name="password" type="password" data-field="password" autocomplete="new-password" maxlength="@AccountRules.MaxPasswordLength"
                                   placeholder="@AccountRules.MinPasswordLength a @AccountRules.MaxPasswordLength caracteres">
                        </label>
                        <label class="field">
                            <span>Confirmar senha</span>
                            <input name="confirmation" type="password" data-field="confirmation" autocomplete="new-password"
                                   maxlength="@AccountRules.MaxPasswordLength" placeholder="Repita a senha">
                        </label>
                        <label class="field">
                            <span>Código de indicação (opcional)</span>
                            <input name="referral" data-field="referral" maxlength="@AccountRules.MaxReferralCodeLength" spellcheck="false"
                                   autocapitalize="characters" placeholder="QUEM TE CONVIDOU?">
                        </label>
                        @* Never shown: a form that fills it was sent by a bot. *@
                        <input class="trap" name="site" data-field="site" tabindex="-1" autocomplete="off" aria-hidden="true">
                        <div class="field">
                            <span>Termos de uso</span>
                            <div class="terms" data-role="terms" tabindex="0" aria-label="Regulamento geral e termos de uso">
                                @foreach (var block in Terms.Blocks)
                                {
                                    switch (block.Kind)
                                    {
                                        case TermsBlockKind.Title:
                                            <h2 class="terms-title">@block.Text</h2>
                                            break;
                                        case TermsBlockKind.Subtitle:
                                            <p class="terms-subtitle">@block.Text</p>
                                            break;
                                        case TermsBlockKind.Notice:
                                            <p class="terms-notice">@block.Text</p>
                                            break;
                                        case TermsBlockKind.Heading:
                                            <h3 class="terms-heading">@block.Text</h3>
                                            break;
                                        default:
                                            <p>@block.Text</p>
                                            break;
                                    }
                                }
                            </div>
                        </div>
                        <p class="terms-hint" data-role="terms-hint">Role o texto até o fim para poder aceitar.</p>
                        <label class="check check-terms">
                            <input type="checkbox" data-field="terms" data-role="terms-accept" disabled>
                            <span>Li e aceito os Termos de Uso</span>
                        </label>
                        @if (Turnstile.Enabled)
                        {
                            <div class="cf-turnstile register-check" data-sitekey="@Turnstile.SiteKey" data-theme="dark" data-language="pt-br"></div>
                        }
                        <p class="card-message" data-role="register-message" role="status" aria-live="polite"></p>
                        <div class="register-actions">
                            <button type="submit" class="card-button" data-role="register-submit">Criar conta</button>
                            <button type="button" class="card-button card-button-outline" data-role="register-cancel">Cancelar</button>
                        </div>
                    </form>
                </div>
            </section>
            @if (Turnstile.Enabled)
            {
                <script src="@Turnstile.ScriptAddress" async defer></script>
            }

            @* The gear's Settings panel: settings.js fills each tab's cards from the game's settings (BrowserHost.Settings)
               and saves them in the page's storage. *@
            <dialog class="card card-framed card-settings" data-role="settings" aria-labelledby="settings-title">
                <header class="settings-head">
                    <h2 class="settings-title" id="settings-title"><span class="settings-diamond" aria-hidden="true"></span><span data-settings-text="title">Configurações</span></h2>
                    <button type="button" class="settings-close" data-role="settings-close" aria-label="Fechar">×</button>
                </header>
                <div class="settings-tabs" role="tablist">
                    <button type="button" role="tab" data-tab="video" aria-selected="true">
                        <span class="settings-tab-icon" aria-hidden="true"><span class="settings-tab-emoji">🖥️</span></span>
                        <span data-settings-text="video">Vídeo</span>
                    </button>
                    <button type="button" role="tab" data-tab="audio" aria-selected="false">
                        <span class="settings-tab-icon" aria-hidden="true"><span class="settings-tab-emoji">🔊</span></span>
                        <span data-settings-text="audio">Áudio</span>
                    </button>
                    <button type="button" role="tab" data-tab="keys" aria-selected="false">
                        <span class="settings-tab-icon" aria-hidden="true"><span class="settings-tab-emoji">⌨️</span></span>
                        <span data-settings-text="keys">Teclas</span>
                    </button>
                    <button type="button" role="tab" data-tab="other" aria-selected="false">
                        <span class="settings-tab-icon" aria-hidden="true"><span class="settings-tab-emoji">⚙️</span></span>
                        <span data-settings-text="other">Outros</span>
                    </button>
                </div>
                <div class="settings-body" data-role="settings-body" role="tabpanel"></div>
                <nav class="settings-site" data-role="settings-site" aria-label="Site" hidden>
                    <partial name="_PlaySiteLinks" />
                </nav>
                <footer class="settings-foot">
                    <p class="settings-note" data-role="settings-note" aria-live="polite"></p>
                    <button type="button" class="settings-cancel" data-role="settings-cancel" data-settings-text="cancel">Cancelar</button>
                    <button type="button" class="settings-save" data-role="settings-save" data-settings-text="save">Salvar</button>
                </footer>
            </dialog>

            @* News & Support as the Settings panel draws it (news.js): the game keeps the feed's read state and the tickets'
               conversation with the server; the page reads it and sends the window's actions. *@
            <dialog class="card card-framed card-settings card-news" data-role="news" aria-labelledby="news-title">
                <header class="settings-head">
                    <h2 class="settings-title" id="news-title"><span class="settings-diamond" aria-hidden="true"></span><span data-news-text="title">Novidades &amp; Suporte</span></h2>
                    <div class="news-social">
                        <button type="button" class="news-social-button news-discord" data-news-link="discord" hidden>
                            <svg class="news-brand" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.058a.082.082 0 0 0 .031.056 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .078-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
                            <span>Discord</span>
                        </button>
                        <button type="button" class="news-social-button news-instagram" data-news-link="instagram" hidden>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.6"/><circle cx="16.8" cy="7.2" r=".6"/></svg>
                            <span>Instagram</span>
                        </button>
                        <button type="button" class="news-social-button news-x" data-news-link="x" hidden>
                            <svg class="news-brand" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932zM17.61 20.644h2.039L6.486 3.24H4.298z"/></svg>
                            <span>X</span>
                        </button>
                    </div>
                    <button type="button" class="settings-close" data-role="news-close" aria-label="Fechar">×</button>
                </header>
                <div class="settings-tabs news-tabs" role="tablist">
                    <button type="button" role="tab" data-news-tab="news" aria-selected="true">
                        <span class="settings-tab-icon" aria-hidden="true"><span class="settings-tab-emoji">📜</span></span>
                        <span data-news-text="news">Novidades</span>
                    </button>
                    <button type="button" role="tab" data-news-tab="tickets" aria-selected="false">
                        <span class="settings-tab-icon" aria-hidden="true"><span class="settings-tab-emoji">🎫</span></span>
                        <span data-news-text="tickets">Meus tickets</span>
                    </button>
                    <button type="button" role="tab" data-news-tab="new" aria-selected="false">
                        <span class="settings-tab-icon" aria-hidden="true"><span class="settings-tab-emoji">✉️</span></span>
                        <span data-news-text="newTicket">Novo ticket</span>
                    </button>
                </div>
                <div class="settings-body news-body" data-role="news-body" role="tabpanel"></div>
                <footer class="settings-foot news-foot" data-role="news-foot" hidden>
                    <p class="settings-note" data-role="news-note" aria-live="polite"></p>
                    <button type="button" class="settings-cancel" data-role="news-form-cancel" hidden data-news-text="cancelEdit">Cancelar</button>
                    <button type="button" class="settings-save" data-role="news-send" data-news-text="send">Enviar ticket</button>
                </footer>
                <div class="news-confirm" data-role="news-confirm" role="alertdialog" aria-labelledby="news-confirm-title" hidden>
                    <div class="news-confirm-box">
                        <header class="news-confirm-head"><span class="news-confirm-mark" aria-hidden="true">?</span><h3 id="news-confirm-title" data-news-text="openLink">Abrir link?</h3></header>
                        <p class="news-confirm-question" data-role="news-confirm-question"></p>
                        <p class="news-confirm-address" data-role="news-confirm-address"></p>
                        <div class="news-confirm-actions">
                            <button type="button" class="settings-cancel" data-role="news-confirm-cancel"><span data-news-text="cancel">Cancelar</span> <kbd>Esc</kbd></button>
                            <button type="button" class="settings-save" data-role="news-confirm-open"><span data-news-text="open">Abrir</span> <kbd>Enter</kbd></button>
                        </div>
                    </div>
                </div>
            </dialog>

            @* The character screen over the 3D stage (CharacterSelectScreen.Web.cs reports its state; main.js draws it):
               the list ("Seus heróis") and the creation's steps (tribe, class, appearance and name). The stage between
               the panels still takes clicks. *@
            <section class="heroes" data-role="heroes" data-screen="roster" hidden>
                <header class="heroes-head">
                    <p class="card-kicker" data-role="heroes-kicker"></p>
                    <h1 class="heroes-title" data-role="heroes-title"></h1>
                    <ol class="heroes-steps" data-role="heroes-steps"></ol>
                </header>
                <aside class="card heroes-panel heroes-roster" data-role="roster-panel"></aside>
                <aside class="card heroes-panel heroes-info" data-role="info-panel"></aside>
                <div class="heroes-tribes" data-role="tribe-row"></div>
                <div class="heroes-classes" data-role="class-row"></div>
                <aside class="card heroes-panel heroes-appearance" data-role="appearance-panel"></aside>
                <p class="heroes-message" data-role="heroes-message" role="status" aria-live="polite"></p>
                <footer class="heroes-actions" data-role="heroes-actions"></footer>
            </section>

            <div class="world-hud" data-role="world-hud" data-state="inactive">
                <p class="world-hud-status">
                    <strong data-role="world-realm">Noxius</strong>
                    <span class="world-hud-status-divider" aria-hidden="true">·</span>
                    <span class="world-hud-metrics">
                        <span data-role="world-fps">— FPS</span>
                        <span aria-hidden="true">·</span>
                        <span data-role="world-ping">— ms</span>
                    </span>
                </p>
                <p class="world-online" data-role="world-online" role="status" hidden>
                    <span class="world-online-dot" aria-hidden="true"></span>
                    <span data-role="world-online-count"></span>
                </p>
                <nav class="world-hud-controls" aria-label="Atalhos do jogo">
                    <button type="button" class="world-hud-button" data-world-action="news">
                        <span class="world-hud-emoji" aria-hidden="true">📰</span>
                        <span data-world-label="news">Novidades &amp; Suporte</span>
                    </button>
                    <div class="world-hud-control-row">
                        <div class="world-hud-hunt">
                            <button type="button" class="world-hud-button" data-world-action="auto-hunt-panel"
                                    aria-haspopup="dialog" aria-controls="world-hunt-panel">
                                <span class="world-hud-emoji" aria-hidden="true">🤖</span>
                                <span data-world-label="auto-hunt-panel">Auto-caça</span>
                            </button>
                            <button type="button" class="world-hud-button world-hud-run-icon" data-role="world-hunt-quick-toggle"
                                    data-world-action="auto-hunt" aria-pressed="false" aria-label="Alternar auto-caça">
                                <svg viewBox="0 0 16 16" aria-hidden="true"><path class="world-hud-run" d="m6 4 6 4-6 4z"/><path class="world-hud-stop" d="M5 5h6v6H5z"/></svg>
                            </button>
                        </div>
                        <details class="world-hud-more" data-role="world-more">
                            <summary class="world-hud-button">
                                <span data-world-label="more">Mais</span>
                                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
                            </summary>
                            <div class="world-hud-menu">
                                <button type="button" data-world-action="calendar">
                                    <span class="world-hud-emoji" aria-hidden="true">📅</span>
                                    <span data-world-label="calendar">Calendário</span>
                                </button>
                                <button type="button" data-world-action="auction" data-world-optional hidden>
                                    <span class="world-hud-emoji" aria-hidden="true">⚖️</span>
                                    <span data-world-label="auction">Leilão</span>
                                </button>
                                <button type="button" data-world-action="security">
                                    <span class="world-hud-emoji" aria-hidden="true">🛡️</span>
                                    <span data-world-label="security">Segurança</span>
                                </button>
                                <button type="button" data-world-action="drops">
                                    <span class="world-hud-emoji" aria-hidden="true">💎</span>
                                    <span data-world-label="drops">Últimos drops</span>
                                </button>
                                <button type="button" data-world-action="coin-history" data-world-optional hidden>
                                    <span class="world-hud-emoji" aria-hidden="true">🪙</span>
                                    <span data-world-label="coin-history">Histórico de Coins</span>
                                </button>
                                <button type="button" data-world-action="events">
                                    <span class="world-hud-emoji" aria-hidden="true">🎉</span>
                                    <span data-world-label="events">Eventos</span>
                                </button>
                                <button type="button" data-world-action="arena-solo">
                                    <span class="world-hud-emoji" aria-hidden="true">⚔️</span>
                                    <span data-world-label="arena-solo">Arena 1x1</span>
                                </button>
                                <button type="button" data-world-action="arena-trio">
                                    <span class="world-hud-emoji" aria-hidden="true">🛡️</span>
                                    <span data-world-label="arena-trio">Arena 3x3</span>
                                </button>
                                <button type="button" data-world-action="tower-defender" data-world-optional hidden>
                                    <span class="world-hud-emoji" aria-hidden="true">🗼</span>
                                    <span data-world-label="tower-defender">Tower Defender</span>
                                </button>
                                <button type="button" data-world-action="eragon" data-world-optional hidden>
                                    <span class="world-hud-emoji" aria-hidden="true">🏰</span>
                                    <span data-world-label="eragon">Lar do Eragon</span>
                                </button>
                                <button type="button" data-world-action="ranking">
                                    <span class="world-hud-emoji" aria-hidden="true">🏆</span>
                                    <span data-world-label="ranking">Ranking</span>
                                </button>
                                <button type="button" data-world-action="rewards">
                                    <span class="world-hud-emoji" aria-hidden="true">📦</span>
                                    <span data-world-label="rewards">Distribuidor</span>
                                </button>
                                <button type="button" data-world-action="item-shop" data-world-optional hidden>
                                    <span class="world-hud-emoji" aria-hidden="true">🛒</span>
                                    <span data-world-label="item-shop">Loja de Itens</span>
                                </button>
                                <button type="button" data-world-action="community-buffs">
                                    <span class="world-hud-emoji" aria-hidden="true">✨</span>
                                    <span data-world-label="community-buffs">Buffs da Comunidade</span>
                                </button>
                            </div>
                        </details>
                    </div>
                </nav>
                <dialog class="touch-choice" data-role="touch-choice" aria-labelledby="touch-choice-title">
                    <h2 id="touch-choice-title"><span class="settings-diamond" aria-hidden="true"></span>Como você quer jogar?</h2>
                    <p>Dá para mudar depois em Configurações, Outros, Tipo de interface.</p>
                    <div class="touch-choice-options">
                        <button type="button" data-touch-choice="Touch">
                            <span aria-hidden="true">📱</span>
                            <strong>HUD de celular</strong>
                            <span>Joystick, botões de ataque e habilidades na tela.</span>
                        </button>
                        <button type="button" data-touch-choice="Pc">
                            <span aria-hidden="true">🖥️</span>
                            <strong>HUD de PC</strong>
                            <span>A interface do computador, tocando como se fosse o mouse.</span>
                        </button>
                    </div>
                </dialog>
                <div class="touch-hud" data-role="touch-hud" hidden>
                    <button type="button" class="touch-player" data-touch-action="character" aria-label="Personagem">
                        <canvas data-role="touch-player" aria-hidden="true"></canvas>
                    </button>
                    <canvas class="touch-target" data-role="touch-target" aria-hidden="true" hidden></canvas>
                    <button type="button" class="touch-orb touch-chat" data-touch-chat aria-label="Chat"></button>
                    <div class="touch-chat-feed" data-role="touch-chat-feed" aria-live="polite"></div>
                    <dialog class="touch-chat-window" data-role="touch-chat-window" aria-labelledby="touch-chat-title">
                        <header class="touch-chat-head">
                            <h2 id="touch-chat-title" data-touch-label="chat">Chat</h2>
                            <button type="button" class="touch-chat-close" data-touch-chat-close aria-label="Fechar">×</button>
                        </header>
                        <div class="touch-chat-options">
                            <span data-touch-label="chat-feed">Mensagens na tela</span>
                            <button type="button" data-touch-chat-feed aria-pressed="true">Mostrando</button>
                        </div>
                        <div class="touch-chat-log" data-role="touch-chat-log"></div>
                        <form class="touch-chat-send" data-role="touch-chat-form">
                            <input type="text" data-role="touch-chat-input" autocomplete="off" enterkeyhint="send"
                                   placeholder="Escreva uma mensagem…" aria-label="Mensagem">
                            <button type="submit" data-touch-label="send">Enviar</button>
                        </form>
                    </dialog>
                    <nav class="touch-dock" aria-label="Janelas do jogo">
                        <button type="button" class="touch-orb touch-dock-orb" data-touch-menu-open aria-label="Menu"></button>
                        <button type="button" class="touch-orb touch-dock-orb" data-touch-action="inventory" aria-label="Bolsa"></button>
                        <button type="button" class="touch-orb touch-dock-orb" data-touch-hunt aria-label="Auto-caça"></button>
                    </nav>
                    <p class="touch-hunt-chip" data-role="touch-hunt-chip" data-touch-label="hunt-on" role="status" hidden>Auto-caça · Ligado</p>
                    <div class="touch-menu" data-role="touch-menu" hidden>
                        <header class="touch-menu-head">
                            <strong data-role="touch-menu-name"></strong>
                            <button type="button" class="touch-menu-close" data-touch-menu-close aria-label="Fechar menu">×</button>
                        </header>
                        <div class="touch-menu-row">
                            <button type="button" class="touch-menu-entry" data-touch-action="inventory" data-touch-glyph="bag"><span data-touch-label="bag">Inventário</span></button>
                            <button type="button" class="touch-menu-entry" data-touch-action="quests" data-touch-glyph="journal"><span data-touch-label="quests">Missões</span></button>
                            <button type="button" class="touch-menu-entry" data-world-action="events" data-touch-glyph="gift"><span data-world-label="events">Eventos</span></button>
                        </div>
                        <div class="touch-menu-row">
                            <button type="button" class="touch-menu-entry" data-touch-action="skills" data-touch-glyph="skill"><span data-touch-label="skills">Habilidades</span></button>
                            <button type="button" class="touch-menu-entry" data-touch-action="touch-run" data-touch-glyph="run"><span data-touch-label="run">Corrida</span></button>
                            <button type="button" class="touch-menu-entry" data-world-action="mail" data-touch-glyph="chat"><span data-touch-label="mail">Correios</span></button>
                        </div>
                        <div class="touch-menu-row">
                            <button type="button" class="touch-menu-entry" data-touch-action="character" data-touch-glyph="shield"><span data-touch-label="character">Personagem</span></button>
                            <button type="button" class="touch-menu-entry" data-world-action="calendar" data-touch-glyph="calendar"><span data-world-label="calendar">Calendário</span></button>
                            <button type="button" class="touch-menu-entry" data-touch-menu="settings" data-touch-glyph="menu"><span data-touch-label="settings">Configurações</span></button>
                        </div>
                        <div class="touch-menu-grid">
                            <button type="button" data-world-action="auction" data-world-optional hidden>
                                <span class="world-hud-emoji" aria-hidden="true">⚖️</span>
                                <span data-world-label="auction">Leilão</span>
                            </button>
                            <button type="button" data-world-action="security">
                                <span class="world-hud-emoji" aria-hidden="true">🛡️</span>
                                <span data-world-label="security">Segurança</span>
                            </button>
                            <button type="button" data-world-action="drops">
                                <span class="world-hud-emoji" aria-hidden="true">💎</span>
                                <span data-world-label="drops">Últimos drops</span>
                            </button>
                            <button type="button" data-world-action="coin-history" data-world-optional hidden>
                                <span class="world-hud-emoji" aria-hidden="true">🪙</span>
                                <span data-world-label="coin-history">Histórico de Coins</span>
                            </button>
                            <button type="button" data-world-action="arena-solo">
                                <span class="world-hud-emoji" aria-hidden="true">⚔️</span>
                                <span data-world-label="arena-solo">Arena 1x1</span>
                            </button>
                            <button type="button" data-world-action="arena-trio">
                                <span class="world-hud-emoji" aria-hidden="true">🛡️</span>
                                <span data-world-label="arena-trio">Arena 3x3</span>
                            </button>
                            <button type="button" data-world-action="royale">
                                <span class="world-hud-emoji" aria-hidden="true">👑</span>
                                <span data-world-label="royale">Battle Royale</span>
                            </button>
                            <button type="button" data-world-action="tower-defender" data-world-optional hidden>
                                <span class="world-hud-emoji" aria-hidden="true">🗼</span>
                                <span data-world-label="tower-defender">Tower Defender</span>
                            </button>
                            <button type="button" data-world-action="eragon" data-world-optional hidden>
                                <span class="world-hud-emoji" aria-hidden="true">🏰</span>
                                <span data-world-label="eragon">Lar do Eragon</span>
                            </button>
                            <button type="button" data-world-action="ranking">
                                <span class="world-hud-emoji" aria-hidden="true">🏆</span>
                                <span data-world-label="ranking">Ranking</span>
                            </button>
                            <button type="button" data-world-action="rewards">
                                <span class="world-hud-emoji" aria-hidden="true">📦</span>
                                <span data-world-label="rewards">Distribuidor</span>
                            </button>
                            <button type="button" data-world-action="item-shop" data-world-optional hidden>
                                <span class="world-hud-emoji" aria-hidden="true">🛒</span>
                                <span data-world-label="item-shop">Loja de Itens</span>
                            </button>
                            <button type="button" data-world-action="community-buffs">
                                <span class="world-hud-emoji" aria-hidden="true">✨</span>
                                <span data-world-label="community-buffs">Buffs da Comunidade</span>
                            </button>
                        </div>
                        <div class="touch-menu-row">
                            <button type="button" class="touch-menu-entry touch-menu-wide" data-world-action="lobby" data-touch-glyph="journal"><span data-touch-label="lobby">Trocar personagem</span></button>
                        </div>
                    </div>
                    <div class="touch-wheel" aria-label="Combate" role="group">
                        <button type="button" class="touch-orb touch-attack" data-touch-action="touch-attack" aria-label="Atacar"></button>
                        <button type="button" class="touch-orb touch-skill" data-touch-action="touch-skill:0" data-touch-slot="0"></button>
                        <button type="button" class="touch-orb touch-skill" data-touch-action="touch-skill:1" data-touch-slot="1"></button>
                        <button type="button" class="touch-orb touch-skill" data-touch-action="touch-skill:2" data-touch-slot="2"></button>
                        <button type="button" class="touch-orb touch-skill" data-touch-action="touch-skill:3" data-touch-slot="3"></button>
                        <button type="button" class="touch-orb touch-potion" data-touch-action="touch-belt:0" data-touch-box="0"></button>
                        <button type="button" class="touch-orb touch-potion" data-touch-action="touch-belt:1" data-touch-box="1"></button>
                        <button type="button" class="touch-orb touch-potion" data-touch-action="touch-belt:2" data-touch-box="2"></button>
                    </div>
                    <canvas class="touch-experience" data-role="touch-experience" aria-hidden="true"></canvas>
                </div>
                <dialog class="world-hunt-panel" id="world-hunt-panel" data-role="world-hunt-panel" aria-labelledby="world-hunt-title">
                    <header class="world-hunt-head">
                        <h2 id="world-hunt-title"><span class="settings-diamond" aria-hidden="true"></span><span data-world-label="auto-hunt-panel">Auto-caça</span></h2>
                        <button type="button" class="world-hunt-close" data-world-action="close-hunt" aria-label="Fechar auto-caça">×</button>
                    </header>
                    <div class="world-hunt-body">
                        <div class="world-hunt-controls">
                            <span class="world-hunt-chip" aria-hidden="true">AUTO-CAÇA</span>
                            <strong data-role="world-hunt-status" role="status">Desligada</strong>
                            <button type="button" class="world-hunt-toggle" data-role="world-hunt-toggle" data-world-action="auto-hunt" aria-pressed="false">
                                <svg viewBox="0 0 16 16" aria-hidden="true"><path class="world-hud-run" d="m6 4 6 4-6 4z"/><path class="world-hud-stop" d="M5 5h6v6H5z"/></svg>
                                <span class="world-hud-run" data-world-label="start-hunt">Iniciar</span>
                                <span class="world-hud-stop" data-world-label="pause-hunt">Pausar</span>
                            </button>
                        </div>
                        <p class="world-hunt-note" data-world-label="hunt-requirement">Disponível fora da cidade, durante uma missão de caça ativa.</p>
                    </div>
                </dialog>
            </div>

            <section class="world-loading" data-role="world-loading" aria-label="Carregamento do mapa" hidden>
                <div class="world-loading-content">
                    <p class="world-loading-name" data-role="world-loading-name"></p>
                    <div class="world-loading-meter">
                        <progress data-role="world-loading-progress" value="0" max="100" aria-label="Carregamento do mapa"></progress>
                        <span class="world-loading-percent" data-role="world-loading-percent" aria-hidden="true">0%</span>
                    </div>
                    <p class="world-loading-status" data-role="world-loading-status" role="status">Carregando...</p>
                </div>
            </section>

            <div class="game-loading" data-role="loading" role="status" aria-live="polite">
                <img class="loading-emblem" src="~/img/noxius-logo-512.png" srcset="/img/noxius-logo-1024.png 2x" alt="Noxius" width="240" height="160">
                <progress data-role="progress" max="100" aria-label="Carregamento do jogo"></progress>
                <span data-role="status">Carregando o jogo…</span>
            </div>
            <script type="module" src="@BrowserClient.EntryScript"></script>
        }
    </div>
</body>
</html>
