<Project Sdk="Microsoft.NET.Sdk">
  <!-- Packs the browser client's bootstrap.txt files into world-packs/*.zip and world-packs.json (docs/tools.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PristonTale.WebAssetPacks</RootNamespace>
    <AssemblyName>ptwebpacks</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\PristonTale.Assets\PristonTale.Assets.csproj" />
  </ItemGroup>
</Project>
