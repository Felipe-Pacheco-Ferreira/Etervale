<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- [JSExport] marshalling is generated as unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- As the desktop client: culture-invariant formatting, text resources looked up by the language's name. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <!-- Not trimmed when interpreted: the game and MonoGame create types by reflection (content readers, JSON data),
         which the trimmer cannot follow. The AOT publish below trims only the framework's assemblies. -->
    <PublishTrimmed>false</PublishTrimmed>
    <MonoGamePlatform>Web</MonoGamePlatform>
    <EtervaleThreeRenderer>true</EtervaleThreeRenderer>
    <!-- The game's assets/ folder, beside the repository's root as for the desktop client; the publish copies the files the
         login needs from it (EtervaleBootstrapFiles). -->
    <EtervaleAssets>$(MSBuildThisFileDirectory)../../assets/</EtervaleAssets>
  </PropertyGroup>
  <!-- The game is compiled ahead of time to WebAssembly: interpreted, a field's Update and Draw alone exceeded a 60 Hz
       frame (docs/web-client.md, AOT publish). -p:EtervaleAot=false publishes the interpreted client. AOT needs the
       trimmer; the partial mode trims only the framework's assemblies and keeps the game's and MonoGame's whole. -->
  <PropertyGroup Condition="'$(EtervaleAot)' != 'false'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- The game reads its JSON by reflection; trimming turns that off unless kept on. Moving those reads to
         source-generated JSON removes the need for this switch and the suppression below. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <!-- Stripping IL after AOT fails on the framework's facade assemblies, which have no compiled methods. -->
    <WasmStripILAfterAOT>false</WasmStripILAfterAOT>
  </PropertyGroup>
  <!-- The MonoGame fork's browser runtime (WebGPU), linked into dotnet.native.wasm; needs the wasm-tools workload. -->
  <Import Project="../../monogame/runtime/src/web/BrowserRuntime.props" />
  <ItemGroup>
    <ProjectReference Include="../PristonTale.Gameplay/PristonTale.Gameplay.csproj" />
    <ProjectReference Include="../../monogame/pipeline/MonoGame.Effect.Processor/MonoGame.Effect.Processor.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.6" />
  </ItemGroup>
  <!-- The browser's assets, fetched by BootstrapFiles.cs. bootstrap.txt lists them by path relative to the client's root. -->
  <Target Name="EtervaleBootstrapFiles" AfterTargets="Publish">
    <Error Condition="!Exists('$(EtervaleAssets)StartImage/Opening/Intro.wav')"
           Text="The game data's assets/ folder is missing at $(EtervaleAssets) (README.md, Requirements)." />
    <PropertyGroup>
      <_EtervalePreviewMotionDirectory>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'preview-motions'))</_EtervalePreviewMotionDirectory>
      <_EtervalePreviewToolArtifacts>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'preview-motion-tool'))</_EtervalePreviewToolArtifacts>
      <_EtervaleDotNetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_EtervaleDotNetHost>
      <_EtervaleDotNetHost Condition="'$(_EtervaleDotNetHost)' == ''">dotnet</_EtervaleDotNetHost>
    </PropertyGroup>
    <Exec Command="&quot;$(_EtervaleDotNetHost)&quot; run --project &quot;$(MSBuildThisFileDirectory)../../tools/PristonTale.AssetDump/PristonTale.AssetDump.csproj&quot; --configuration $(Configuration) --artifacts-path &quot;$(_EtervalePreviewToolArtifacts)&quot; -- --export-preview-skeletons &quot;$(EtervaleAssets)&quot; &quot;$(_EtervalePreviewMotionDirectory)&quot;"
          EnvironmentVariables="NuGetAudit=$(NuGetAudit);RestoreIgnoreFailedSources=$(RestoreIgnoreFailedSources)" />
