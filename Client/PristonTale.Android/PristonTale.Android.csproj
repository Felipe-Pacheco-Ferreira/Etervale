<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>org.etervale.android.prototype</ApplicationId>
    <ApplicationVersion>18</ApplicationVersion>
    <ApplicationDisplayVersion>0.18</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PristonTale.Client.Net/PristonTale.Client.Net.csproj" />
    <ProjectReference Include="../../Shared/PristonTale.Assets/PristonTale.Assets.csproj" />
    <AndroidAsset Include="Resources/ricarten.smd" Link="ricarten.smd" />
    <AndroidAsset Include="$(BaseIntermediateOutputPath)ricarten-resources/Mobile/ricarten-scene.bin" Link="ricarten-scene.bin" />

  </ItemGroup>
  <Target Name="ExtractRicartenResources" BeforeTargets="PrepareForBuild">
    <Unzip SourceFiles="Resources/ricarten.zip" DestinationFolder="$(BaseIntermediateOutputPath)ricarten-resources" />
    <ItemGroup>
      <AndroidAsset Include="$(BaseIntermediateOutputPath)ricarten-resources/Mobile/ChatBox/*.png" Link="ChatBox/%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>
</Project>
